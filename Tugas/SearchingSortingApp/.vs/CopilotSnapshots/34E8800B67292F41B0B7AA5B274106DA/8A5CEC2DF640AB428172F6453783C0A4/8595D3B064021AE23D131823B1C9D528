namespace SearchingSortingApp
{
    public partial class Form1 : Form
    {
        string[] namaAwal = {
            "Andi","Budi","Citra","Deni","Eka",
            "Fajar","Gita","Hana","Ilham","Joko",
            "Kiki","Lina","Miko","Nadia","Oscar",
            "Putri","Qori","Raka","Sari","Tono",
            "Umar","Vina","Widi","Xena","Yoga"
        };

        int[] nilaiAwal = {
            78,55,90,42,67,
            88,33,75,91,60,
            48,82,55,70,39,
            85,63,77,91,50,
            68,44,80,57,73
        };

        List<int[]> stepsNilai = new List<int[]>();
        List<string[]> stepsNama = new List<string[]>();
        List<string> stepKeterangan = new List<string>();

        List<int[]> stepKuning = new List<int[]>();
        List<int[]> stepMerah = new List<int[]>();
        List<int[]> stepHijau = new List<int[]>();

        int currentStep = 0;

        // AUTO PLAY
        Timer timer = new Timer();
        bool isPlaying = false;

        public Form1()
        {
            InitializeComponent();

            timer.Interval = 800;
            timer.Tick += Timer_Tick;

            ShowData(namaAwal, nilaiAwal);
        }

        void Timer_Tick(object sender, EventArgs e)
        {
            if (currentStep < stepsNilai.Count - 1)
            {
                currentStep++;
                ShowStep();
            }
            else
            {
                timer.Stop();
                isPlaying = false;
                btnAuto.Text = "Auto";
            }
        }

        void ShowData(string[] nama, int[] nilai)
        {
            dgvData.Rows.Clear();
            for (int i = 0; i < nama.Length; i++)
                dgvData.Rows.Add(i + 1, nama[i], nilai[i]);
        }

        void SimpanLangkah(int[] nilai, string[] nama,
            int[] kuning, int[] merah, int[] hijau, string ket)
        {
            stepsNilai.Add((int[])nilai.Clone());
            stepsNama.Add((string[])nama.Clone());
            stepKuning.Add(kuning);
            stepMerah.Add(merah);
            stepHijau.Add(hijau);
            stepKeterangan.Add(ket);
        }

        void ShowStep()
        {
            dgvData.Rows.Clear();

            var nilai = stepsNilai[currentStep];
            var nama = stepsNama[currentStep];

            var kuning = stepKuning[currentStep];
            var merah = stepMerah[currentStep];
            var hijau = stepHijau[currentStep];

            for (int i = 0; i < nama.Length; i++)
            {
                dgvData.Rows.Add(i + 1, nama[i], nilai[i]);

                if (Array.IndexOf(merah, i) >= 0)
                    dgvData.Rows[i].DefaultCellStyle.BackColor = Color.Salmon;
                else if (Array.IndexOf(kuning, i) >= 0)
                    dgvData.Rows[i].DefaultCellStyle.BackColor = Color.Yellow;
                else if (Array.IndexOf(hijau, i) >= 0)
                    dgvData.Rows[i].DefaultCellStyle.BackColor = Color.LightGreen;
                else
                    dgvData.Rows[i].DefaultCellStyle.BackColor = Color.White;
            }

            lblLangkah.Text = $"Langkah {currentStep + 1}";
            lblKeterangan.Text = stepKeterangan[currentStep];
        }

        // ================= BUBBLE =================
        void Bubble()
        {
            ResetStep();

            string[] n = (string[])namaAwal.Clone();
            int[] v = (int[])nilaiAwal.Clone();

            for (int i = 0; i < v.Length - 1; i++)
            {
                for (int j = 0; j < v.Length - i - 1; j++)
                {
                    SimpanLangkah(v, n, new int[] { j, j + 1 }, new int[] { }, new int[] { },
                        $"Bandingkan {v[j]} dan {v[j + 1]}");

                    if (v[j] > v[j + 1])
                    {
                        int t = v[j]; v[j] = v[j + 1]; v[j + 1] = t;
                        string s = n[j]; n[j] = n[j + 1]; n[j + 1] = s;

                        SimpanLangkah(v, n, new int[] { }, new int[] { j, j + 1 }, new int[] { },
                            "Tukar posisi");
                    }
                }
            }

            FinishStep(v, n, "Bubble selesai");
        }

        // ================= SELECTION =================
        void SelectionSort()
        {
            ResetStep();

            string[] n = (string[])namaAwal.Clone();
            int[] v = (int[])nilaiAwal.Clone();

            for (int i = 0; i < v.Length - 1; i++)
            {
                int min = i;

                for (int j = i + 1; j < v.Length; j++)
                {
                    SimpanLangkah(v, n, new int[] { min, j }, new int[] { }, new int[] { },
                        $"Bandingkan {v[min]} dengan {v[j]}");

                    if (v[j] < v[min]) min = j;
                }

                if (min != i)
                {
                    int t = v[i]; v[i] = v[min]; v[min] = t;
                    string s = n[i]; n[i] = n[min]; n[min] = s;

                    SimpanLangkah(v, n, new int[] { }, new int[] { i, min }, new int[] { },
                        "Tukar dengan minimum");
                }
            }

            FinishStep(v, n, "Selection selesai");
        }

        // ================= INSERTION =================
        void InsertionSort()
        {
            ResetStep();

            string[] n = (string[])namaAwal.Clone();
            int[] v = (int[])nilaiAwal.Clone();

            for (int i = 1; i < v.Length; i++)
            {
                int key = v[i];
                string keyN = n[i];
                int j = i - 1;

                SimpanLangkah(v, n, new int[] { i }, new int[] { }, new int[] { },
                    $"Ambil {key}");

                while (j >= 0 && v[j] > key)
                {
                    v[j + 1] = v[j];
                    n[j + 1] = n[j];

                    SimpanLangkah(v, n, new int[] { j }, new int[] { j + 1 }, new int[] { },
                        "Geser ke kanan");

                    j--;
                }

                v[j + 1] = key;
                n[j + 1] = keyN;

                SimpanLangkah(v, n, new int[] { }, new int[] { }, new int[] { j + 1 },
                    "Sisipkan ke posisi benar");
            }

            FinishStep(v, n, "Insertion selesai");
        }

        // ================= HELPER =================
        void ResetStep()
        {
            stepsNilai.Clear();
            stepsNama.Clear();
            stepKeterangan.Clear();
            stepKuning.Clear();
            stepMerah.Clear();
            stepHijau.Clear();
        }

        void FinishStep(int[] v, string[] n, string ket)
        {
            int[] semua = new int[v.Length];
            for (int i = 0; i < v.Length; i++) semua[i] = i;

            SimpanLangkah(v, n, new int[] { }, new int[] { }, semua, ket);

            currentStep = 0;
            ShowStep();
        }

        // ================= SEARCH =================
        private void btnSearch_Click(object sender, EventArgs e)
        {
            int cari = int.Parse(txtCari.Text);

            dgvData.ClearSelection();

            for (int i = 0; i < nilaiAwal.Length; i++)
            {
                if (nilaiAwal[i] == cari)
                    dgvData.Rows[i].DefaultCellStyle.BackColor = Color.LightGreen;
            }
        }

        // ================= BUTTON =================
        private void btnBubble_Click(object sender, EventArgs e) => Bubble();
        private void btnSelection_Click(object sender, EventArgs e) => SelectionSort();
        private void btnInsertion_Click(object sender, EventArgs e) => InsertionSort();

        private void btnNext_Click(object sender, EventArgs e)
        {
            if (currentStep < stepsNilai.Count - 1)
            {
                currentStep++;
                ShowStep();
            }
        }

        private void btnPrev_Click(object sender, EventArgs e)
        {
            if (currentStep > 0)
            {
                currentStep--;
                ShowStep();
            }
        }

        private void btnAuto_Click(object sender, EventArgs e)
        {
            if (!isPlaying)
            {
                timer.Start();
                isPlaying = true;
                btnAuto.Text = "Pause";
            }
            else
            {
                timer.Stop();
                isPlaying = false;
                btnAuto.Text = "Auto";
            }
        }

