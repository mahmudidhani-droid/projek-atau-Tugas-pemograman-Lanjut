using System;
using System.Collections.Generic;
using System.Drawing;
using System.Linq;
using System.Windows.Forms;

namespace SearchingSortingApp
{
    public class Form1 : Form
    {
        DataGridView dgvManual = new DataGridView();
        DataGridView dgvTabelManual = new DataGridView();

        Button btnBubbleManual = new Button();
        Button btnSelectionManual = new Button();
        Button btnInsertionManual = new Button();
        Button btnCountingManual = new Button();
        Button btnSequentialManual = new Button();
        Button btnBinaryManual = new Button();
        Button btnNextManual = new Button();
        Button btnPrevManual = new Button();
        Button btnAutoManual = new Button();

        TextBox txtCariManual = new TextBox();
        Label lblManual = new Label();

        int[] data = { 78, 55, 90, 62, 88, 70 };
        List<int[]> steps = new List<int[]>();
        int step = 0;

        int perbandingan = 0;
        int pertukaran = 0;

        Timer timer = new Timer();

        public Form1()
        {
            this.Text = "FULL Searching Sorting App";
            this.Size = new Size(800, 500);

            // DATA GRID
            dgvManual.ColumnCount = 3;
            dgvManual.Columns[0].Name = "No";
            dgvManual.Columns[1].Name = "Nama";
            dgvManual.Columns[2].Name = "Nilai";
            dgvManual.Location = new Point(10, 10);
            dgvManual.Size = new Size(350, 200);

            // TABEL PERBANDINGAN
            dgvTabelManual.ColumnCount = 3;
            dgvTabelManual.Columns[0].Name = "Algoritma";
            dgvTabelManual.Columns[1].Name = "Perbandingan";
            dgvTabelManual.Columns[2].Name = "Pertukaran";
            dgvTabelManual.Location = new Point(400, 10);
            dgvTabelManual.Size = new Size(350, 200);

            // BUTTONS
            btnBubbleManual.Text = "Bubble"; btnBubbleManual.Location = new Point(10, 220);
            btnSelectionManual.Text = "Selection"; btnSelectionManual.Location = new Point(90, 220);
            btnInsertionManual.Text = "Insertion"; btnInsertionManual.Location = new Point(190, 220);
            btnCountingManual.Text = "Counting"; btnCountingManual.Location = new Point(290, 220);

            btnSequentialManual.Text = "Seq Search"; btnSequentialManual.Location = new Point(10, 260);
            btnBinaryManual.Text = "Binary Search"; btnBinaryManual.Location = new Point(120, 260);

            btnNextManual.Text = "Next"; btnNextManual.Location = new Point(10, 300);
            btnPrevManual.Text = "Prev"; btnPrevManual.Location = new Point(90, 300);
            btnAutoManual.Text = "Auto"; btnAutoManual.Location = new Point(170, 300);

            txtCariManual.Location = new Point(250, 260);

            lblManual.Location = new Point(10, 340);

            // EVENTS
            btnBubbleManual.Click += (s, e) => Bubble();
            btnSelectionManual.Click += (s, e) => Selection();
            btnInsertionManual.Click += (s, e) => Insertion();
            btnCountingManual.Click += (s, e) => Counting();

            btnSequentialManual.Click += (s, e) => Sequential();
            btnBinaryManual.Click += (s, e) => Binary();

            btnNextManual.Click += (s, e) => { if (step < steps.Count - 1) { step++; ShowStep(); } };
            btnPrevManual.Click += (s, e) => { if (step > 0) { step--; ShowStep(); } };

            btnAutoManual.Click += (s, e) => timer.Start();
            timer.Interval = 500;
            timer.Tick += (s, e) =>
            {
                if (step < steps.Count - 1)
                {
                    step++;
                    ShowStep();
                }
                else timer.Stop();
            };

            // ADD CONTROL
            this.Controls.AddRange(new Control[] {
                dgvManual, dgvTabelManual,
                btnBubbleManual, btnSelectionManual, btnInsertionManual, btnCountingManual,
                btnSequentialManual, btnBinaryManual,
                btnNextManual, btnPrevManual, btnAutoManual,
                txtCariManual, lblManual
            });

            ShowData(data);
        }

        void ShowData(int[] arr)
        {
            dgvManual.Rows.Clear();
            for (int i = 0; i < arr.Length; i++)
                dgvManual.Rows.Add(i + 1, "Data " + (i + 1), arr[i]);
        }

        void Save(int[] arr)
        {
            steps.Add((int[])arr.Clone());
        }

        void ShowStep()
        {
            ShowData(steps[step]);
            lblManual.Text = $"Step {step + 1} | Perbandingan: {perbandingan} | Tukar: {pertukaran}";
        }

        void Reset()
        {
            steps.Clear();
            step = 0;
            perbandingan = 0;
            pertukaran = 0;
        }

        void Bubble()
        {
            Reset();
            int[] arr = (int[])data.Clone();

            for (int i = 0; i < arr.Length - 1; i++)
                for (int j = 0; j < arr.Length - i - 1; j++)
                {
                    perbandingan++;
                    if (arr[j] > arr[j + 1])
                    {
                        int t = arr[j];
                        arr[j] = arr[j + 1];
                        arr[j + 1] = t;
                        pertukaran++;
                        Save(arr);
                    }
                }

            step = 0;
            ShowStep();
            AddTable("Bubble");
        }

        void Selection()
        {
            Reset();
            int[] arr = (int[])data.Clone();

            for (int i = 0; i < arr.Length - 1; i++)
            {
                int min = i;
                for (int j = i + 1; j < arr.Length; j++)
                {
                    perbandingan++;
                    if (arr[j] < arr[min]) min = j;
                }
                int t = arr[min];
                arr[min] = arr[i];
                arr[i] = t;
                pertukaran++;
                Save(arr);
            }

            step = 0;
            ShowStep();
            AddTable("Selection");
        }

        void Insertion()
        {
            Reset();
            int[] arr = (int[])data.Clone();

            for (int i = 1; i < arr.Length; i++)
            {
                int key = arr[i];
                int j = i - 1;

                while (j >= 0 && arr[j] > key)
                {
                    perbandingan++;
                    arr[j + 1] = arr[j];
                    j--;
                    pertukaran++;
                    Save(arr);
                }
                arr[j + 1] = key;
                Save(arr);
            }

            step = 0;
            ShowStep();
            AddTable("Insertion");
        }

        void Counting()
        {
            Reset();
            int max = data.Max();
            int[] count = new int[max + 1];

            foreach (var num in data)
                count[num]++;

            List<int> result = new List<int>();
            for (int i = 0; i < count.Length; i++)
                for (int j = 0; j < count[i]; j++)
                    result.Add(i);

            Save(result.ToArray());
            ShowStep();
            AddTable("Counting");
        }

        void Sequential()
        {
            int target = int.Parse(txtCariManual.Text);
            for (int i = 0; i < data.Length; i++)
            {
                if (data[i] == target)
                {
                    MessageBox.Show("Ditemukan di index " + i);
                    return;
                }
            }
            MessageBox.Show("Tidak ditemukan");
        }

        void Binary()
        {
            int target = int.Parse(txtCariManual.Text);
            int[] arr = (int[])data.Clone();
            Array.Sort(arr);

            int l = 0, r = arr.Length - 1;
            while (l <= r)
            {
                int mid = (l + r) / 2;
                if (arr[mid] == target)
                {
                    MessageBox.Show("Ditemukan");
                    return;
                }
                else if (arr[mid] < target) l = mid + 1;
                else r = mid - 1;
            }
            MessageBox.Show("Tidak ditemukan");
        }

        void AddTable(string nama)
        {
            dgvTabelManual.Rows.Add(nama, perbandingan, pertukaran);
        }
    }
}