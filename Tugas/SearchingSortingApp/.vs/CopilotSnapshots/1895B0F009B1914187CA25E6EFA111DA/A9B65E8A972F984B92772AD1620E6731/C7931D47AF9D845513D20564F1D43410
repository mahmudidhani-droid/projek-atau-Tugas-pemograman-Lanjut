        // Added missing btnSearch_Click event handler referenced by the designer
        private void btnSearch_Click(object sender, EventArgs e)
        {
            var query = txtCari.Text?.Trim();
            if (string.IsNullOrEmpty(query))
            {
                MessageBox.Show("Masukkan kata kunci pencarian.");
                return;
            }

            // If input is an integer, perform numeric binary search on values
            if (int.TryParse(query, out int cari))
            {
                BinarySearch(cari);
                return;
            }

            // Otherwise perform a simple case-insensitive name search
            var matches = new List<string>();
            for (int i = 0; i < namaAwal.Length; i++)
            {
                if (namaAwal[i].IndexOf(query, StringComparison.OrdinalIgnoreCase) >= 0)
                    matches.Add($"{i + 1}: {namaAwal[i]} ({nilaiAwal[i]})");
            }

            if (matches.Count > 0)
                MessageBox.Show("Ditemukan:\n" + string.Join("\n", matches));
            else
                MessageBox.Show("Tidak ditemukan");
        }

