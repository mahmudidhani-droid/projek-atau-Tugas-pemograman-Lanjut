        void ShowData(string[] nama, int[] nilai)
        {
            dgvData.Rows.Clear();
            for (int i = 0; i < nama.Length; i++)
                dgvData.Rows.Add(i + 1, nama[i], nilai[i]);
        }

        void SimpanLangkah(int[] nilai, string[] nama,
            int[] kuning, int[] merah, int[] hijau, string ket)
        {
            stepsNilai.Add((int[])nilai.Clone());
            stepsNama.Add((string[])nama.Clone());
            stepKuning.Add(kuning);
            stepMerah.Add(merah);
            stepHijau.Add(hijau);
            stepKeterangan.Add(ket);
        }

        void ShowStep()
        {
            dgvData.Rows.Clear();

            var nilai = stepsNilai[currentStep];
            var nama = stepsNama[currentStep];
            var kuning = stepKuning[currentStep];
            var merah = stepMerah[currentStep];
            var hijau = stepHijau[currentStep];

            for (int i = 0; i < nama.Length; i++)
            {
                dgvData.Rows.Add(i + 1, nama[i], nilai[i]);

                if (Array.IndexOf(merah, i) >= 0)
                    dgvData.Rows[i].DefaultCellStyle.BackColor = Color.Red;
                else if (Array.IndexOf(kuning, i) >= 0)
                    dgvData.Rows[i].DefaultCellStyle.BackColor = Color.Yellow;
                else if (Array.IndexOf(hijau, i) >= 0)
                    dgvData.Rows[i].DefaultCellStyle.BackColor = Color.LightGreen;
                else
                    dgvData.Rows[i].DefaultCellStyle.BackColor = Color.White;
            }

            lblLangkah.Text = $"Langkah: {currentStep + 1}/{stepsNilai.Count}";
            lblKeterangan.Text = "Keterangan: " + stepKeterangan[currentStep];
        }

        void FinishStep(int[] v, string[] n, string ket)
        {
            SimpanLangkah(v, n, new int[] { }, new int[] { }, new int[] { }, ket);
            currentStep = 0;
            ShowStep();
        }

        // ================= SORT =================
        void Bubble()
        {
            ResetStep();

            int[] v = (int[])nilaiAwal.Clone();
            string[] n = (string[])namaAwal.Clone();

            int banding = 0;
            int tukar = 0;

            for (int i = 0; i < v.Length - 1; i++)
            {
                for (int j = 0; j < v.Length - i - 1; j++)
                {
                    banding++;

                    SimpanLangkah(v, n,
                        new int[] { j, j + 1 },
                        new int[] { },
                        new int[] { },
                        $"Bandingkan {n[j]}({v[j]}) dengan {n[j + 1]}({v[j + 1]})");

                    if (v[j] > v[j + 1])
                    {
                        tukar++;

                        (v[j], v[j + 1]) = (v[j + 1], v[j]);
                        (n[j], n[j + 1]) = (n[j + 1], n[j]);

                        SimpanLangkah(v, n,
                            new int[] { },
                            new int[] { j, j + 1 },
                            new int[] { },
                            "Tukar posisi");
                    }
                }

                SimpanLangkah(v, n,
                    new int[] { },
                    new int[] { },
                    new int[] { v.Length - i - 1 },
                    "Sudah benar");
            }

            // record results first, then update labels using the specific index for Bubble (0)
            hasilPerbandingan[0] = banding;
            hasilPertukaran[0] = tukar;
            lblPerbandingan.Text = "Perbandingan: " + hasilPerbandingan[0];
            lblPertukaran.Text = "Pertukaran: " + hasilPertukaran[0];

            currentStep = 0;
            ShowStep();
        }
        void SelectionSort()
        {
            ResetStep();

            int[] v = (int[])nilaiAwal.Clone();
            string[] n = (string[])namaAwal.Clone();

            for (int i = 0; i < v.Length - 1; i++)
            {
                int min = i;

                for (int j = i + 1; j < v.Length; j++)
                {
                    SimpanLangkah(v, n,
                        new int[] { j, min },
                        new int[] { },
                        new int[] { },
                        $"Bandingkan {n[j]} dengan minimum");

                    if (v[j] < v[min])
                        min = j;
                }

                if (min != i)
                {
                    (v[i], v[min]) = (v[min], v[i]);
                    (n[i], n[min]) = (n[min], n[i]);

                    SimpanLangkah(v, n,
                        new int[] { },
                        new int[] { i, min },
                        new int[] { },
                        "Tukar minimum");
                }

                SimpanLangkah(v, n,
                    new int[] { },
                    new int[] { },
                    new int[] { i },
                    "Posisi fix");
            }

            currentStep = 0;
            ShowStep();
        }

        void InsertionSort()
        {
            ResetStep();

            int[] v = (int[])nilaiAwal.Clone();
            string[] n = (string[])namaAwal.Clone();

            int banding = 0;
            int tukar = 0;

            for (int i = 1; i < v.Length; i++)
            {
                int key = v[i];
                string keyN = n[i];
                int j = i - 1;

                while (j >= 0)
                {
                    banding++;

                    if (v[j] > key)
                    {
                        v[j + 1] = v[j];
                        n[j + 1] = n[j];
                        tukar++;
                    }
                    else break;

                    j--;
                }

                v[j + 1] = key;
                n[j + 1] = keyN;

                SimpanLangkah(v, n, new int[] { }, new int[] { }, new int[] { },
                    $"Insert {key}");
            }

            // record results first, then update labels using the specific index for Insertion (2)
            hasilPerbandingan[2] = banding;
            hasilPertukaran[2] = tukar;
            lblPerbandingan.Text = "Perbandingan: " + hasilPerbandingan[2];
            lblPertukaran.Text = "Pertukaran: " + hasilPertukaran[2];

            FinishStep(v, n, "Insertion selesai");
        }

        void CountingSort()
        {
            ResetStep();

            int[] v = (int[])nilaiAwal.Clone();
            string[] n = (string[])namaAwal.Clone();

            int min = v[0], max = v[0];

            for (int i = 1; i < v.Length; i++)
            {
                if (v[i] < min) min = v[i];
                if (v[i] > max) max = v[i];
            }

            int[] count = new int[max - min + 1];

            for (int i = 0; i < v.Length; i++)
            {
                count[v[i] - min]++;
            }

            int idx = 0;
            int[] outputV = new int[v.Length];
            string[] outputN = new string[v.Length];

            for (int val = min; val <= max; val++)
            {
                for (int i = 0; i < v.Length; i++)
                {
                    if (v[i] == val)
                    {
                        outputV[idx] = v[i];
                        outputN[idx] = n[i];
                        idx++;
                    }
                }
            }

            // record results first, then update labels using the specific index for Counting (3)
            hasilPerbandingan[3] = 0;
            hasilPertukaran[3] = 0;
            lblPerbandingan.Text = "Perbandingan: " + hasilPerbandingan[3];
            lblPertukaran.Text = "Pertukaran: " + hasilPertukaran[3];

            FinishStep(outputV, outputN, "Counting selesai");
        }

        // ================= SEARCH =================
        void BinarySearch(int cari)
        {
            int[] v = (int[])nilaiAwal.Clone();
            string[] n = (string[])namaAwal.Clone();

            Array.Sort(v, n);

            int l = 0, r = v.Length - 1;

            while (l <= r)
            {
                int mid = (l + r) / 2;

                if (v[mid] == cari)
                {
                    MessageBox.Show($"Ditemukan: {n[mid]}");
                    return;
                }
                else if (v[mid] < cari)
                    l = mid + 1;
                else
                    r = mid - 1;
            }

            MessageBox.Show("Tidak ditemukan");
        }

