        void SequentialSearch(int cari)
        {
            ResetStep();

            for (int i = 0; i < nilaiAwal.Length; i++)
            {
                if (nilaiAwal[i] == cari)
                {
                    SimpanLangkah(nilaiAwal, namaAwal,
                        new int[] { },
                        new int[] { },
                        new int[] { i },
                        $"Ditemukan di index {i}");
                    break;
                }
                else
                {
                    SimpanLangkah(nilaiAwal, namaAwal,
                        new int[] { i },
                        new int[] { },
                        new int[] { },
                        $"Cek index {i}");
                }
            }

            currentStep = 0;
            ShowStep();
        }
