        public Form1()
        {
            InitializeComponent();

            timer.Interval = 800;
            timer.Tick += Timer_Tick;

            ShowData(namaAwal, nilaiAwal);
        }

        void Timer_Tick(object sender, EventArgs e)
        {
            if (currentStep < stepsNilai.Count - 1)
            {
                currentStep++;
                ShowStep();
            }
            else
            {
                timer.Stop();
                isPlaying = false;
                btnAuto.Text = "Auto";
            }
        }

        void ShowData(string[] nama, int[] nilai)
        {
            dgvData.Rows.Clear();
            for (int i = 0; i < nama.Length; i++)
                dgvData.Rows.Add(i + 1, nama[i], nilai[i]);
        }

        void SimpanLangkah(int[] nilai, string[] nama,
            int[] kuning, int[] merah, int[] hijau, string ket)
        {
            stepsNilai.Add((int[])nilai.Clone());
            stepsNama.Add((string[])nama.Clone());
            stepKuning.Add(kuning);
            stepMerah.Add(merah);
            stepHijau.Add(hijau);
            stepKeterangan.Add(ket);
        }

        void ShowStep()
        {
            dgvData.Rows.Clear();

            var nilai = stepsNilai[currentStep];
            var nama = stepsNama[currentStep];

            for (int i = 0; i < nama.Length; i++)
            {
                dgvData.Rows.Add(i + 1, nama[i], nilai[i]);
            }

            lblLangkah.Text = $"Langkah {currentStep + 1}";
            lblKeterangan.Text = stepKeterangan[currentStep];
        }

        void ResetStep()
        {
            stepsNilai.Clear();
            stepsNama.Clear();
            stepKeterangan.Clear();
            stepKuning.Clear();
            stepMerah.Clear();
            stepHijau.Clear();
        }

        void FinishStep(int[] v, string[] n, string ket)
        {
            SimpanLangkah(v, n, new int[] { }, new int[] { }, new int[] { }, ket);
            currentStep = 0;
            ShowStep();
        }

        // ================= SORT =================
        void Bubble()
        {
            ResetStep();

            int[] v = (int[])nilaiAwal.Clone();
            string[] n = (string[])namaAwal.Clone();

            for (int i = 0; i < v.Length - 1; i++)
                for (int j = 0; j < v.Length - i - 1; j++)
                {
                    SimpanLangkah(v, n, new int[] { }, new int[] { }, new int[] { },
                        $"Bandingkan {v[j]} dan {v[j + 1]}");

                    if (v[j] > v[j + 1])
                    {
                        (v[j], v[j + 1]) = (v[j + 1], v[j]);
                        (n[j], n[j + 1]) = (n[j + 1], n[j]);

                        SimpanLangkah(v, n, new int[] { }, new int[] { }, new int[] { },
                            "Tukar");
                    }
                }

            FinishStep(v, n, "Bubble selesai");
        }

        void SelectionSort()
        {
            ResetStep();

            int[] v = (int[])nilaiAwal.Clone();
            string[] n = (string[])namaAwal.Clone();

            for (int i = 0; i < v.Length - 1; i++)
            {
                int min = i;
                for (int j = i + 1; j < v.Length; j++)
                    if (v[j] < v[min]) min = j;

                (v[i], v[min]) = (v[min], v[i]);
                (n[i], n[min]) = (n[min], n[i]);

                SimpanLangkah(v, n, new int[] { }, new int[] { }, new int[] { },
                    $"Tukar posisi {i}");
            }

            FinishStep(v, n, "Selection selesai");
        }

        void InsertionSort()
        {
            ResetStep();

            int[] v = (int[])nilaiAwal.Clone();
            string[] n = (string[])namaAwal.Clone();

            for (int i = 1; i < v.Length; i++)
            {
                int key = v[i];
                string keyN = n[i];
                int j = i - 1;

                while (j >= 0 && v[j] > key)
                {
                    v[j + 1] = v[j];
                    n[j + 1] = n[j];
                    j--;
                }

                v[j + 1] = key;
                n[j + 1] = keyN;

                SimpanLangkah(v, n, new int[] { }, new int[] { }, new int[] { },
                    $"Insert {key}");
            }

            FinishStep(v, n, "Insertion selesai");
        }

        void CountingSort()
        {
            ResetStep();

            int[] v = (int[])nilaiAwal.Clone();
            string[] n = (string[])namaAwal.Clone();

            Array.Sort(v, n);

            SimpanLangkah(v, n, new int[] { }, new int[] { }, new int[] { },
                "Counting selesai");

            currentStep = 0;
            ShowStep();
        }

        // ================= SEARCH =================
        void BinarySearch(int cari)
        {
            int[] v = (int[])nilaiAwal.Clone();
            string[] n = (string[])namaAwal.Clone();

            Array.Sort(v, n);

            int l = 0, r = v.Length - 1;

            while (l <= r)
            {
                int mid = (l + r) / 2;

                if (v[mid] == cari)
                {
                    MessageBox.Show($"Ditemukan: {n[mid]}");
                    return;
                }
                else if (v[mid] < cari)
                    l = mid + 1;
                else
                    r = mid - 1;
            }

            MessageBox.Show("Tidak ditemukan");
        }

        void TampilkanTabel()
